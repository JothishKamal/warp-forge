// One-dimensional vector addition: c[i] = a[i] + b[i] for i < n.
// The canonical data-parallel kernel: one thread per element, with a bounds
// check because the grid is rounded up to a multiple of the block size.
kernel vector_add(float* a, float* b, float* c, int n) {
    int i = global_id();
    if (i < n) {
        c[i] = a[i] + b[i];
    }
}
