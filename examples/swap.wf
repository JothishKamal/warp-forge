// Conditionally swaps two values. At the join, the phis for `a` and `b` take
// each other's inputs on one edge: the textbook shape for out-of-SSA bugs if
// copies are emitted one after another without care. `i < n - 500` selects
// which threads swap.
kernel swap(float* x, float* y, float* out_a, float* out_b, int n) {
    int i = global_id();
    if (i < n) {
        float a = x[i];
        float b = y[i];
        if (i < n - 500) {
            float t = a;
            a = b;
            b = t;
        }
        out_a[i] = a;
        out_b[i] = b;
    }
}
