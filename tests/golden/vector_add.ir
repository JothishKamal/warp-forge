kernel @vector_add(ptr %a, ptr %b, ptr %c, i32 %n) {
entry:
  %i = global_id
  %0 = lt.i32 %i, %n
  condbr %0, if.then, if.end

if.then:
  %1 = addr %a, %i
  %2 = load.f32 %1
  %3 = addr %b, %i
  %4 = load.f32 %3
  %5 = add.f32 %2, %4
  %6 = addr %c, %i
  store.f32 %5, %6
  br if.end

if.end:
  ret
}
