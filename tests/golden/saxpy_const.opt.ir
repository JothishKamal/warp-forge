kernel @saxpy_const(ptr %x, ptr %y, i32 %n) {
entry:
  %i = global_id
  %0 = lt.i32 %i, %n
  condbr %0, if.then.1, if.end.1

if.then.1:
  %1 = addr %x, %i
  %2 = load.f32 %1
  %3 = mul.f32 0x40400000, %2
  %4 = addr %y, %i
  %5 = load.f32 %4
  %6 = add.f32 %3, %5
  %7 = addr %y, %i
  store.f32 %6, %7
  br if.end.1

if.end.1:
  ret
}
