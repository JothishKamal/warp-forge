kernel @float_consts(ptr %out) {
entry:
  %i = global_id
  %0 = lt.i32 %i, 1
  condbr %0, if.then, if.end

if.then:
  %1 = addr %out, 0
  store.f32 0x3E99999A, %1
  %2 = addr %out, 1
  store.f32 0x00000000, %2
  %3 = addr %out, 2
  store.f32 0x7F800000, %3
  %4 = addr %out, 3
  store.f32 0x00000001, %4
  %5 = addr %out, 4
  store.f32 0x80000000, %5
  %6 = addr %out, 5
  store.f32 0x4B800000, %6
  br if.end

if.end:
  ret
}
