; passes: const-fold
; Integer identities fire; the float look-alikes must not.
kernel @k(ptr %o, i32 %n) {
entry:
  %v = load.f32 %o
  %a = add.f32 %v, 0x00000000
  %b = mul.f32 %v, 0x00000000
  %c = sub.f32 %v, %v
  %ia = add.i32 %n, 0
  %ib = mul.i32 %n, 0
  %ic = sub.i32 %n, %n
  %sum = add.i32 %ia, %ib
  %idx = add.i32 %sum, %ic
  %p = addr %o, %idx
  %t = add.f32 %a, %b
  %u = add.f32 %t, %c
  store.f32 %u, %p
  ret
}
